# Keep source and documentation files stable across Windows/Linux checkouts.
* text=auto

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf

*.exe binary
*.dll binary
*.lib binary
*.zip binary
*.pdf binary
*.mseed binary
*.seed binary
*.ms binary
